--- !u!114 &1416107053
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1416107052}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8bcefbe2458f5cc4ebce746228e9747c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_KaaraTextMeshPro: {fileID: 921917123}
  m_Dialoges:
  - _SpeakerName: 0
    _Dialoges: "Hey there, Ranger! I\u2019m Kaara, your Gen 3 AI guide. Ready to
      kick things off?!"
    _DialogAudioClip: {fileID: 8300000, guid: bc1d7a242effb7849befc10acf33070b, type: 3}
  - _SpeakerName: 1
    _Dialoges: 'Hey Kaara, Yes, I''m ready to work ! '
    _DialogAudioClip: {fileID: 8300000, guid: 100f9ff22777a4e4b91cbe72ced837ad, type: 3}
  - _SpeakerName: 0
    _Dialoges: ' Got any questions before we start? '
    _DialogAudioClip: {fileID: 8300000, guid: a51c4b3ca26c0844ea7f83e1328fad77, type: 3}
  - _SpeakerName: 0
    _Dialoges: "Hmm, I\u2019ll take that as a no. So, where do we begin? Oh yeah,
      I forgot you\u2019re a newbie! Let me walk you through the great purpose that
      IGS serves. "
    _DialogAudioClip: {fileID: 8300000, guid: 36d13dfb87e836047b181f277926e077, type: 3}
  m_AudioSource: {fileID: 1098058805}
